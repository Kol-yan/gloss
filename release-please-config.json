{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "packages": {
    ".": {
      "component": "web",
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["extension", "desktop"]
    },
    "extension": {
      "component": "extension",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "manifest.json", "jsonpath": "$.version" }
      ]
    },
    "desktop": {
      "component": "desktop",
      "release-type": "node",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "src-tauri/Cargo.lock", "jsonpath": "$.package[?(@.name.value=='gloss-desktop')].version" }
      ]
    }
  }
}
