{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gloss",
  "version": "0.1.0",
  "identifier": "gloss.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "gloss",
        "url": "settings.html",
        "width": 460,
        "height": 680,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "badge",
        "title": "gloss",
        "url": "badge.html",
        "width": 64,
        "height": 40,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "shadow": false
      },
      {
        "label": "panel",
        "title": "gloss",
        "url": "panel.html",
        "width": 440,
        "height": 480,
        "visible": false,
        "focus": false,
        "decorations": false,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 150,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Check selected text and dictate in any app",
    "longDescription": "gloss checks the English you select in any app and pastes the corrected text back, and turns push-to-talk speech into text in the field you are typing in.",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
