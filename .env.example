# Copy to .env.local and fill in. Never commit real values.

# Meta Model API: smart tier (evaluation of learner answers) and speech-to-text
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_ASR_MODEL=muse-voice-transcribe-1.0

# OpenRouter, funded by the operator: fast tier (proofreading, practice
# situations). Without a key, fast-tier jobs report that cloud checking is off.
# Visitor BYOK keys are never read from here.
OPENROUTER_API_KEY=
# Model or preset id; empty means openai/gpt-oss-120b. The older name
# OPENROUTER_PROOFREAD_MODEL is still read when this one is empty.
OPENROUTER_FAST_MODEL=
# USD per million tokens used to bound and settle the cost of the fast model.
# Empty means the conservative default for gpt-oss-120b. Set both when you use
# a model or preset that can cost more.
OPENROUTER_FAST_PRICE_IN_PER_M=
OPENROUTER_FAST_PRICE_OUT_PER_M=

# Trust CF-Connecting-IP for BYOK enrollment limits only when a trusted proxy
# overwrites it and the application is reachable solely through that proxy.
BYOK_TRUST_PROXY_HEADERS=false

# Global kill switch for all cloud model calls
AI_ENABLED=true

# Hard daily spend ceiling for the whole instance, in USD
DAILY_BUDGET_USD=5

# Owner spend alerts through the existing Telegram bot (optional; both needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite database file (use a persistent volume in production).
# With Docker Compose this is fixed to /app/data/glossy.db by compose.yaml.
GLOSSY_DATABASE_PATH=./data/glossy.db

# Public base URL: printed in invite links, and the only site (besides the
# one the request arrives on) allowed to post the invite form.
# Production example: https://gloss.li
GLOSSY_PUBLIC_URL=http://localhost:3000
